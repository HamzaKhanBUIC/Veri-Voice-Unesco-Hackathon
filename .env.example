# VeriVoice Environment Variables
# Copy this file to .env and supply your credentials for live testing.

# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# Discord Bot Interface Configuration (Primary Free Prototype Interface)
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
DISCORD_MAX_FILE_SIZE_MB=15

# WhatsApp Cloud API Configuration (Optional / Future Interface)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=verivoice_webhook_verify_token
WHATSAPP_API_VERSION=v19.0

# Speech-To-Text (STT) Configuration
# Options: speechmatics | whisper | mock
SPEECH_PROVIDER=speechmatics

# Text-To-Speech (TTS) Configuration (No API Key Required)
# Options: edge-tts | mock
TTS_PROVIDER=edge-tts
TTS_VOICE_URDU=ur-PK-UzmaNeural

# LLM Verification Configuration
# Options: groq | gemini | openai | mock
LLM_PROVIDER=groq

# External API Keys (Multi-Key Rotation Supported for Groq)
GROQ_API_KEY=
GROQ_API_KEY_1=
GROQ_API_KEY_2=
SPEECHMATICS_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=

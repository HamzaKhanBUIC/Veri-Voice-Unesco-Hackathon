# VeriVoice Environment Variables
# Copy this file to .env and supply your credentials for live testing.

# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Discord Bot Configuration
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
DISCORD_MAX_FILE_SIZE_MB=15

# Speech-To-Text (STT) Configuration
# Options: whisper | speechmatics | mock
SPEECH_PROVIDER=whisper

# Text-To-Speech (TTS) Configuration
# Options: elevenlabs | edge-tts | mock
TTS_PROVIDER=elevenlabs
TTS_VOICE_URDU=ur-PK-UzmaNeural
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# LLM Verification Configuration
# Options: groq | gemini | openai | mock
LLM_PROVIDER=groq

# External API Keys (Multi-Key Pools Supported)
GROQ_API_KEY=
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=

ELEVENLABS_API_KEY=
ELEVENLABS_API_KEY_1=
ELEVENLABS_API_KEY_2=
ELEVENLABS_API_KEY_3=
ELEVENLABS_API_KEY_4=

SPEECHMATICS_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
